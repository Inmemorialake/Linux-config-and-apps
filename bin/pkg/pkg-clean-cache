#!/usr/bin/env bash
set -euo pipefail

INFO="\033[1;34m"
WARN="\033[1;33m"
SUCCESS="\033[1;32m"
RESET="\033[0m"

KEEP_VERSIONS=2

header() {
  echo -e "${INFO}//--- Cleaning pacman cache ---//${RESET}"
}

pre_check() {
  echo -e "${WARN}:: This will remove old package versions${RESET}"
  echo -e "${WARN}:: Keeping last $KEEP_VERSIONS versions per package${RESET}"
  echo
}

run_cleanup() {
  sudo paccache -r -k"$KEEP_VERSIONS"
}

post_message() {
  echo
  echo -e "${SUCCESS}✔ Pacman cache cleaned safely${RESET}"
}

main() {
  header
  pre_check
  run_cleanup
  post_message
}

main
