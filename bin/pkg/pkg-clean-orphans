#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────
# Colores estandarizados
# ─────────────────────────────────────────────────────────────
readonly INFO="\033[1;36m"      # Cyan
readonly WARN="\033[1;33m"      # Amarillo
readonly ERROR="\033[1;31m"     # Rojo
readonly SUCCESS="\033[1;32m"   # Verde
readonly BOLD="\033[1m"
readonly RESET="\033[0m"

# ─────────────────────────────────────────────────────────────
# Variables globales
# ─────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="$(basename "$0")"

# ─────────────────────────────────────────────────────────────
# Funciones de logging
# ─────────────────────────────────────────────────────────────
info()    { echo -e "${INFO}ℹ️  [$SCRIPT_NAME]${RESET} $*"; }
warn()    { echo -e "${WARN}⚠️  [$SCRIPT_NAME]${RESET} $*"; }
error()   { echo -e "${ERROR}❌ [$SCRIPT_NAME]${RESET} $*" >&2; }
success() { echo -e "${SUCCESS}✔  [$SCRIPT_NAME]${RESET} $*"; }

# ─────────────────────────────────────────────────────────────
# Función header
# ─────────────────────────────────────────────────────────────
header() {
  local title="$1"
  local emoji="${2:-}"
  local width=60
  
  echo -e "${BOLD}${INFO}"
  echo "//==========================================================//"
  
  local text="$emoji $title"
  local padding=$(( (width - ${#text}) / 2 ))
  printf "%${padding}s%s\n" "" "$text"
  
  echo "//==========================================================//"
  echo -e "${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Función principal
# ─────────────────────────────────────────────────────────────
main() {
  header "Limpieza de paquetes huérfanos" "🗑"
  
  local orphans
  orphans=$(pacman -Qtdq 2>/dev/null || true)
  
  if [[ -z "$orphans" ]]; then
    success "No hay paquetes huérfanos para eliminar"
    exit 0
  fi
  
  warn "Los siguientes paquetes huérfanos serán ELIMINADOS:"
  echo
  
  while read -r pkg; do
    echo "  • $pkg"
  done <<< "$orphans"
  
  echo
  read -rp "¿Proceder con la eliminación? [y/N]: " confirmacion
  
  if [[ ! "$confirmacion" =~ ^[Yy]$ ]]; then
    warn "Operación cancelada por el usuario"
    exit 0
  fi
  
  echo
  info "Eliminando paquetes huérfanos..."
  sudo pacman -Rns $orphans
  
  echo
  success "$SCRIPT_NAME finalizado correctamente"
}

main
