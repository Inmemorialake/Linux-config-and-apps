#!/usr/bin/env bash
set -euo pipefail

echo "⏱ SYSTEMD TIMER AUDIT"
echo "====================="
echo

# 1. Active timers
echo "📌 Active timers:"
systemctl list-timers --all --no-pager

echo
echo "---------------------"
echo

# 2. Timers that missed executions
echo "⚠️ Timers that may have missed runs:"
systemctl list-timers --all --no-legend \
  | awk '$1 == "n/a" || $2 == "n/a" {print $0}' \
  || echo "✅ No missed timers"

echo
echo "---------------------"
echo

# 3. Disabled timers
echo "🛑 Disabled timers:"
systemctl list-unit-files --type=timer --state=disabled --no-legend || echo "✅ No disabled timers"

echo
echo "---------------------"
echo

# 4. Recommendations
echo "💡 Recommendations:"
echo "- Disable timers you don't recognize"
echo "- Investigate timers with 'n/a' last run"
echo "- Prefer timers over cron when possible"

echo
echo "✔ Timer audit completed"
