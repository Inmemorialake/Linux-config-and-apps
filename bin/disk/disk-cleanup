#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────
# Auto-elevación
# ─────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

echo "🧹 DISK CLEANUP"
echo "=============="
echo

# 1. User cache
echo "📂 Cleaning user cache (~/.cache)"
du -sh ~/.cache 2>/dev/null || true
rm -rf ~/.cache/*
echo "✅ User cache cleaned"
echo

# 2. Trash
echo "🗑 Emptying trash"
rm -rf ~/.local/share/Trash/files/*
rm -rf ~/.local/share/Trash/info/*
echo "✅ Trash emptied"
echo

# 3. Pacman cache (requires sudo)
if [[ $EUID -ne 0 ]]; then
  echo "⚠ Pacman cache cleanup requires sudo"
  echo "Run again with: sudo disk-cleanup"
else
  echo "📦 Cleaning pacman cache"
  paccache -r
  echo "✅ Pacman cache cleaned"
fi

echo
echo "✔ Disk cleanup completed"
