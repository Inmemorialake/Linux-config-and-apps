#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────
# Auto-elevación
# ─────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

THRESHOLD=85

echo "📦 DISK SPACE MONITOR"
echo "===================="
echo "⚠ Alert threshold: ${THRESHOLD}%"
echo

df -hP | awk 'NR>1 {print $1, $5, $6}' | while read -r fs usage mount; do
  percent=${usage%\%}

  if [[ $percent -ge $THRESHOLD ]]; then
    echo "❌ $mount at ${usage} (Filesystem: $fs)"
  else
    echo "✅ $mount at ${usage}"
  fi
done

echo
echo "✔ Disk space check completed"
