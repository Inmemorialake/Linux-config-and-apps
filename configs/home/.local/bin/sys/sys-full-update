#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────
# Auto-elevación controlada
# ─────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

# ─────────────────────────────────────────────────────────────
# Colores estandarizados
# ─────────────────────────────────────────────────────────────
readonly INFO="\033[1;36m"      # Cyan
readonly WARN="\033[1;33m"      # Amarillo
readonly ERROR="\033[1;31m"     # Rojo
readonly SUCCESS="\033[1;32m"   # Verde
readonly BOLD="\033[1m"
readonly RESET="\033[0m"

# ─────────────────────────────────────────────────────────────
# Variables globales
# ─────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="$(basename "$0")"
readonly REAL_USER="${SUDO_USER:-}"

# ─────────────────────────────────────────────────────────────
# Funciones de logging
# ─────────────────────────────────────────────────────────────
info()    { echo -e "${INFO}ℹ️  [$SCRIPT_NAME]${RESET} $*"; }
warn()    { echo -e "${WARN}⚠️  [$SCRIPT_NAME]${RESET} $*"; }
error()   { echo -e "${ERROR}❌ [$SCRIPT_NAME]${RESET} $*" >&2; }
success() { echo -e "${SUCCESS}✔  [$SCRIPT_NAME]${RESET} $*"; }

# ─────────────────────────────────────────────────────────────
# Función header
# ─────────────────────────────────────────────────────────────
header() {
  local title="$1"
  local emoji="${2:-}"
  local width=60
  
  echo -e "${BOLD}${INFO}"
  echo "//==========================================================//"
  
  local text="$emoji $title"
  local padding=$(( (width - ${#text}) / 2 ))
  printf "%${padding}s%s\n" "" "$text"
  
  echo "//==========================================================//"
  echo -e "${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Función principal
# ─────────────────────────────────────────────────────────────
main() {
  header "Actualización completa del sistema" "🚀"
  
  # 1. Keyrings
  echo
  info "🔑 Actualizando keyrings"
  echo
  
  # 1.1. Sincronizar repositorios
  pacman -Sy
  echo
  
  # 1.2. Reinstalar keyring
  info "Actualizando archlinux-keyring…"
  echo
  pacman -S --noconfirm archlinux-keyring
  echo
  
  # 1.3. Inicializar y poblar keyring
  info "Inicializando keyring…"
  echo
  pacman-key --init
  echo
  info "Poblando keyring oficial…"
  echo
  pacman-key --populate archlinux
  echo
  success "Keyrings actualizados"
  echo
  
  # 2. Mirrors (reflector)
  if command -v reflector &>/dev/null; then
    info "🌍 Actualizando mirrors"
    echo
    reflector --country Colombia,Brazil,Chile,Argentina,Mexico,UnitedStates,Worldwide --latest 10 --protocol https --sort rate \
      --save /etc/pacman.d/mirrorlist
    echo
    success "Mirrors actualizados"
  else
    warn "reflector no está instalado, omitiendo actualización de mirrors"
  fi
  echo
  
  # 3. Actualización completa del sistema (repos oficiales)
  info "📦 Ejecutando pacman -Syu"
  echo
  pacman -Syu
  echo
  success "Sistema actualizado"
  echo
  
  # 4. AUR (paru, como usuario no-root)
  if [[ -n "$REAL_USER" ]] && command -v paru &>/dev/null; then
    info "🧱 Actualizando paquetes AUR (paru)"
    echo
    sudo -u "$REAL_USER" paru -Syu --devel
    echo
    success "AUR actualizado"
  else
    warn "paru no disponible o REAL_USER no definido, omitiendo AUR"
  fi
  
  echo
  success "$SCRIPT_NAME finalizado correctamente"
}

main
