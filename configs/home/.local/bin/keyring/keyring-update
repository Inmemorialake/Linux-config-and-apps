#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────
# Auto-elevación
# ─────────────────────────────────────────────────────────────
if [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

# ─────────────────────────────────────────────────────────────
# Colores estandarizados
# ─────────────────────────────────────────────────────────────
readonly INFO="\033[1;36m"      # Cyan
readonly WARN="\033[1;33m"      # Amarillo
readonly ERROR="\033[1;31m"     # Rojo
readonly SUCCESS="\033[1;32m"   # Verde
readonly BOLD="\033[1m"
readonly RESET="\033[0m"

# ─────────────────────────────────────────────────────────────
# Variables globales
# ─────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="$(basename "$0")"

AUTO_YES=false
DRY_RUN=false

# ─────────────────────────────────────────────────────────────
# Funciones de logging
# ─────────────────────────────────────────────────────────────
info()    { echo -e "${INFO}ℹ️  [$SCRIPT_NAME]${RESET} $*"; }
warn()    { echo -e "${WARN}⚠️  [$SCRIPT_NAME]${RESET} $*"; }
error()   { echo -e "${ERROR}❌ [$SCRIPT_NAME]${RESET} $*" >&2; }
success() { echo -e "${SUCCESS}✔  [$SCRIPT_NAME]${RESET} $*"; }

# ─────────────────────────────────────────────────────────────
# Función header
# ─────────────────────────────────────────────────────────────
header() {
  local title="$1"
  local emoji="${2:-}"
  local width=60
  
  echo -e "${BOLD}${INFO}"
  echo "//==========================================================//"
  
  local text="$emoji $title"
  local padding=$(( (width - ${#text}) / 2 ))
  printf "%${padding}s%s\n" "" "$text"
  
  echo "//==========================================================//"
  echo -e "${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Función de ayuda
# ─────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Uso: $SCRIPT_NAME [opciones]

Opciones:
  --dry-run     Muestra qué se haría sin ejecutar cambios
  --yes         No pide confirmación
  -h, --help    Muestra esta ayuda
EOF
}

# ─────────────────────────────────────────────────────────────
# Parse de argumentos
# ─────────────────────────────────────────────────────────────
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=true ;;
      --yes)     AUTO_YES=true ;;
      -h|--help) usage; exit 0 ;;
      *) error "Opción desconocida: $1"; exit 1 ;;
    esac
    shift
  done
}

# ─────────────────────────────────────────────────────────────
# Función principal
# ─────────────────────────────────────────────────────────────
main() {
  parse_args "$@"
  
  header "Actualización de keyrings" "🔑"
  
  info "Este proceso actualizará y reparará los keyrings de Arch"
  echo
  
  if [[ "$DRY_RUN" == true ]]; then
    warn "Modo DRY-RUN activado"
  else
    if [[ "$AUTO_YES" == false ]]; then
      read -rp "¿Deseas continuar? [y/N]: " respuesta
      [[ "$respuesta" =~ ^[Yy]$ ]] || {
        warn "Operación cancelada"
        exit 0
      }
    fi
  fi
  
  echo
  
  # 1. Sincronizar repositorios
  if [[ "$DRY_RUN" == true ]]; then
    info "[DRY-RUN] pacman -Sy"
  else
    info "Sincronizando repositorios…"
    pacman -Sy
  fi
  
  # 2. Reinstalar keyring
  if [[ "$DRY_RUN" == true ]]; then
    info "[DRY-RUN] pacman -S --noconfirm archlinux-keyring"
  else
    info "Actualizando archlinux-keyring…"
    pacman -S --noconfirm archlinux-keyring
  fi
  
  # 3. Inicializar y poblar keyring (seguro aunque ya exista)
  if [[ "$DRY_RUN" == true ]]; then
    info "[DRY-RUN] pacman-key --init"
    info "[DRY-RUN] pacman-key --populate archlinux"
  else
    info "Inicializando keyring…"
    pacman-key --init
    
    info "Poblando keyring oficial…"
    pacman-key --populate archlinux
  fi
  
  echo
  success "$SCRIPT_NAME finalizado correctamente"
}

main "$@"
