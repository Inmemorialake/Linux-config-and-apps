#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

# ─────────────────────────────────────────────────────────────
# Colores estandarizados
# ─────────────────────────────────────────────────────────────
readonly INFO="\033[1;36m"      # Cyan
readonly WARN="\033[1;33m"      # Amarillo
readonly ERROR="\033[1;31m"     # Rojo
readonly SUCCESS="\033[1;32m"   # Verde
readonly BOLD="\033[1m"
readonly RESET="\033[0m"

# ─────────────────────────────────────────────────────────────
# Variables globales
# ─────────────────────────────────────────────────────────────
readonly SCRIPT_NAME="$(basename "$0")"

# ─────────────────────────────────────────────────────────────
# Funciones de logging
# ─────────────────────────────────────────────────────────────
info()    { echo -e "${INFO}ℹ️  [$SCRIPT_NAME]${RESET} $*"; }
warn()    { echo -e "${WARN}⚠️  [$SCRIPT_NAME]${RESET} $*"; }
error()   { echo -e "${ERROR}❌ [$SCRIPT_NAME]${RESET} $*" >&2; }
success() { echo -e "${SUCCESS}✔  [$SCRIPT_NAME]${RESET} $*"; }

# ─────────────────────────────────────────────────────────────
# Función header
# ─────────────────────────────────────────────────────────────
header() {
  local title="$1"
  local emoji="${2:-}"
  local width=60
  
  echo -e "${BOLD}${INFO}"
  echo "//==========================================================//"
  
  local text="$emoji $title"
  local padding=$(( (width - ${#text}) / 2 ))
  printf "%${padding}s%s\n" "" "$text"
  
  echo "//==========================================================//"
  echo -e "${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Función principal
# ─────────────────────────────────────────────────────────────
main() {
  header "Uso de logs del sistema" "📜"
  
  info "Revisando uso de journald…"
  echo
  
  # Uso total
  journalctl --disk-usage || {
    error "No se pudo obtener el uso de journald"
    exit 1
  }
  
  echo
  
  # Límites configurados
  info "Configuración relevante de journald:"
  grep -E '^(SystemMaxUse|RuntimeMaxUse|SystemKeepFree|RuntimeKeepFree)' \
    /etc/systemd/journald.conf 2>/dev/null || \
    warn "No hay límites explícitos configurados (valores por defecto en uso)"
  
  echo
  
  # Rango temporal de logs
  info "Rango temporal de logs:"
  journalctl --list-boots | head -n 1
  journalctl --list-boots | tail -n 1
  
  echo
  success "$SCRIPT_NAME finalizado correctamente"
}

main
