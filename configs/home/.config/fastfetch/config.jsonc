{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "/home/Inmemorialake/.local/share/konsole/Arch Terminal Logo.png",
        "padding": {
            "top": 5,
            "right": 2,
            "left": 2
        }
    },

    "display": {
        "separator": " ✦ "
    },

    "modules": [
        "break",

        // ── System ── (Purple)
        {
            "type": "custom",
            "format": "\u001b[35m━━━ System Information ━━━\u001b[0m"
        },
        { "type": "os",       "key": "󰣇",     "keyColor": "35" },
        { "type": "kernel",   "key": "",     "keyColor": "35" },
        { "type": "uptime",   "key": "󰐦",     "keyColor": "35" },
        { "type": "packages", "key": "󰏓 ",   "keyColor": "35" },

        "break",

        // ── Desktop ── (Blue)
        {
            "type": "custom",
            "format": "\u001b[34m━━ Desktop Environment ━━\u001b[0m"
        },
        { "type": "de",       "key": "󰧨 ",   "keyColor": "34" },
        { "type": "wm",       "key": "󱂬 ",   "keyColor": "34" },
        { "type": "terminal", "key": "",     "keyColor": "34" },
        { "type": "shell",    "key": "󰞷 ",   "keyColor": "34" },

        "break",

        // ── Hardware ── (Purple)
        {
            "type": "custom",
            "format": "\u001b[35m━━━ Hardware Information ━━━\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "󰻠 ",
            "keyColor": "35",
            "format": "{1} ({3})"
        },
        { "type": "gpu",    "key": "󰢮 ", "keyColor": "35" },
        { "type": "memory", "key": "󰍛 ", "keyColor": "35" },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "35",
            "folders": "/"
        },

        "break",

        // ── Network ── (Blue)
        {
            "type": "custom",
            "format": "\u001b[34m━━ Network ━━\u001b[0m"
        },
        { "type": "localip", "key": "󰩟 ", "keyColor": "34" },

        "break",

        // ── Palette Preview ──
        {
            "type": "colors",
            "key": "󰌁 ",
            "symbol": "circle"
        },

        "break"
    ]
}
