[AC][Performance]
PowerProfile=performance

[Battery][Display]
DimDisplayIdleTimeoutSec=60
TurnOffDisplayIdleTimeoutSec=120
TurnOffDisplayIdleTimeoutWhenLockedSec=20

[Battery][Performance]
PowerProfile=power-saver

[Battery][SuspendAndShutdown]
